{
  "manifest_version": 3,
  "name": "X AIリプ アシスタント",
  "version": "0.3.0",
  "description": "Xの投稿にAIリプ候補を表示する拡張機能。送信は必ず人間が行います。",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
