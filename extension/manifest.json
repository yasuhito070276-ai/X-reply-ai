{
  "manifest_version": 3,
  "name": "X AIリプ アシスタント",
  "version": "0.9.0",
  "description": "Xの投稿からリプ生成プロンプトを作ってコピーし、専用のChatGPTチャットを表示する拡張機能。送信は必ず人間が行います。",
  "permissions": ["tabs", "storage", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
