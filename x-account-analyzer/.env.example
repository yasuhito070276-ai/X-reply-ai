# このファイルを .env という名前でコピーして、必要なキーだけ設定してください。
# 例:  cp .env.example .env   (Mac)  /  copy .env.example .env  (Windows)
# .env は .gitignore に登録済みなので Git には保存されません。

# ---- X 公式 API（任意。CSVだけで使う場合は不要）----
# X Developer Portal で取得した Bearer Token
X_BEARER_TOKEN=

# ---- AI 分析（任意。設定しなくてもルールベース分析が動きます）----
# Anthropic API キー（https://console.anthropic.com/）
ANTHROPIC_API_KEY=

# OpenAI API キー（https://platform.openai.com/）
OPENAI_API_KEY=

# 使用するモデル名を変えたい場合のみ設定（省略時は既定値を使用）
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
